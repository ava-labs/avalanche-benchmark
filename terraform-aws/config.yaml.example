prefix: "ilya-failover-bench"
project: "avalanche-benchmark"

# Required by org SCP p-9zri1kwo. Terraform sends Owner and Project tags for
# both the instance and its root volume in the RunInstances request.
owner: "ilya.solohin@avalabs.org"

# Public key imported independently into both regions.
public_key_path: "~/.ssh/fleet.pub"

site_a_region: "us-west-1"
site_b_region: "us-west-2"
instance_type: "m6a.4xlarge"

# Optional. If omitted, Terraform detects the caller's public IP. Keep this a
# single trusted operator /32; it gates SSH, Grafana, and Prometheus ingress.
# operator_cidr: "203.0.113.10/32"

# Must match the mainnet p-chain-follow-only bootstrap flag in the kit config.
# RPC nodes can reach this one destination on this one TCP port.
mainnet_upstream_cidr: "54.232.137.108/32"
mainnet_upstream_port: 9651
