  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per-server avalanchego process state: down, up but not yet serving, serving.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 72,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "not serving",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "serving",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(up{job=\"avalanche-l1\"} + on(instance) group_left() (max by (instance) (avalanche_snowman_bootstrap_finished{chain!~\"C|P|X|all\"}) and on(instance) up{job=\"avalanche-l1\"} == 1)) or (up{job=\"avalanche-l1\"} * 1)",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "avalanchego up/down",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "On-chain weight from the fleet exporter, bucketed into tiers: dead=1, spare=1000, validator=1000000. Mid-ratchet intermediate weights land in the nearest tier.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 72,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 10,
                "result": {
                  "text": "dead",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 10,
                "to": 500000,
                "result": {
                  "text": "spare",
                  "color": "yellow",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 500000,
                "to": null,
                "result": {
                  "text": "validator",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 2,
      "options": {
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "fleet_actual_weight",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Stake tier per server (P-chain)",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of consensus polls that reached a decisive result, per site. Dips mark consensus stress during a failover.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum by (site) (increase(avalanche_snowman_polls_successful{chain!~\"C|P|X|all\"}[1m]))) / (sum by (site) (increase(avalanche_snowman_polls_successful{chain!~\"C|P|X|all\"}[1m])) + sum by (site) (increase(avalanche_snowman_polls_failed{chain!~\"C|P|X|all\"}[1m]))) * 100",
          "legendFormat": "{{site}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Successful polls %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Canonically accepted transactions per second, max across nodes to ignore a lagging scrape.",
