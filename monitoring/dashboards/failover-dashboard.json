    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Max finalized height per site. B overtakes A at failover; A catches up on restore. A flat segment is a halt \u2014 its width is downtime.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 102,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (site) (avalanche_snowman_last_accepted_height{chain!~\"C|P|X|all\"})",
          "legendFormat": "{{site}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Finalized (last-accepted) height \u2014 A vs B",
