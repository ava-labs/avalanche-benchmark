        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(rate(avalanche_snowman_blks_accepted_count{chain!~\"P|C|X|all\"}[1m]))",
          "refId": "A",
