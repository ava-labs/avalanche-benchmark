    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Largest gap between consecutive blocks (proposerVM millisecond timestamps via the `timestampMilliseconds` header field), per site, from the blockprobe exporter. This is the proposer-stall metric Ilya's window improves: a missing proposer stalls production for ~100ms with the 100ms window vs ~5s with the stock window. Spikes here during a failover/restore = the real recovery time, at ms resolution (computed at block granularity, not scrape-sampled). The max series folds in the live age of the latest block, so an in-progress stall shows immediately rather than only once the next block lands.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 130,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (site) (l1_block_gap_ms_max)",
          "legendFormat": "{{site}} — max gap",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (site) (l1_block_gap_ms_last)",
          "legendFormat": "{{site}} — last gap",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Max inter-block gap (ms) \u2014 proposer stall",
      "type": "timeseries"
    },
