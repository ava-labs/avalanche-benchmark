    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Unprocessed consensus (sync) messages queued in each node's handler. This is the direct 'I am drowning' signal: a node receiving blocks faster than it can verify/execute them sees this queue grow without bound.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 208,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (avalanche_handler_sync_unprocessed_msgs_count{chain!~\"C|P|X|all\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Unprocessed consensus-message queue by node",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Worst message-handling time per node (max over message ops). Spikes here are the engine stalling on a single oversized message - e.g. a behind tracker choking on a large block 'put', holding the consensus lock and freezing all progress for the duration.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ns"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 209,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (instance) (avalanche_handler_message_handling_time{chain!~\"C|P|X|all\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worst message handling time by node",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Site B's block-acceptance rate as a fraction of site A's (1m). 1.00 = B is keeping up with the tip (sustainable ingress). Below 1.00 = B is falling behind at that fraction of A's rate, so the A-vs-B gap is widening \u2014 lower the bombard rps until this holds at 1.0. The sweet-spot TPS is the highest rate at which this stays green.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "unit": "none",
          "min": 0,
          "max": 1.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "id": 210,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(rate(avalanche_snowman_blks_accepted_count{site=\"b\",chain!~\"C|P|X|all\"}[1m])) / max(rate(avalanche_snowman_blks_accepted_count{site=\"a\",chain!~\"C|P|X|all\"}[1m]))",
          "legendFormat": "B/A keep-up ratio",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Site B keep-up ratio (synced when = 1.0)",
      "type": "stat"
    }
