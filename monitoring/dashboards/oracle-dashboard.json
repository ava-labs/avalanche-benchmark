          "expr": "sum(rate(oracle_relay_e2e_latency_seconds_sum[2m])) / sum(rate(oracle_relay_e2e_latency_seconds_count[2m]))",
          "refId": "A",
          "legendFormat": "avg"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oracle_relay_e2e_latency_seconds_bucket[2m])))",
          "refId": "B",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
