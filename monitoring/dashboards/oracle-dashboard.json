     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "oracle_relay_inflight",
     "refId": "A",
     "legendFormat": "in-flight queue"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(oracle_relay_delivered_total) - sum(oracle_relay_confirmed_total)",
