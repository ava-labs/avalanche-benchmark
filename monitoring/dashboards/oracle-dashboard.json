    {
      "id": 9,
      "type": "timeseries",
      "title": "End-to-end latency \u2014 submit ts \u2192 confirmed (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
