  {
   "id": 8,
   "type": "row",
   "title": "Cross-chain latency \u2014 oracle \u2192 main",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 15
   },
   "panels": []
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Delivery latency \u2014 oracle event \u2192 confirmed on main",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(oracle_relay_pipeline_latency_seconds_bucket[2m])))",
     "refId": "A",
     "legendFormat": "p50"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(oracle_relay_pipeline_latency_seconds_bucket[2m])))",
     "refId": "B",
     "legendFormat": "p95"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(oracle_relay_pipeline_latency_seconds_bucket[2m])))",
     "refId": "C",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "description": "Wall-clock from the relay seeing the aggregator's Warp event on the oracle chain to the delivery tx confirming on main: the full cross-chain hop. Sub-second precision (the relay's own clock, not block timestamps)."
  },
  {
   "id": 100,
   "type": "timeseries",
   "title": "Price age on main \u2014 how far main lags the oracle",
   "description": "Age of the price currently served on main, measured against the oracle event that produced it. Exported as a value at confirm time, so it is immune to scrape-interval and block-timestamp rounding. Lower = fresher.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (asset) (oracle_relay_main_price_staleness_seconds)",
     "refId": "A",
     "legendFormat": "{{asset}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 103,
   "type": "timeseries",
   "title": "Signature collection \u2014 local keys vs p2p ACP-118 (p50/p95)",
   "description": "Time to produce one message's quorum BitSetSignature. local = the relay signs with control-held BLS keys in-process; p2p = the relay requests signatures from the oracle validators over their staking ports (the icm-services signature-aggregator wire protocol) and aggregates at quorum. The gap is the price of not holding keys.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "legendFormat": "{{mode}} p50",
     "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(oracle_relay_sign_latency_seconds_bucket[2m])))"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "legendFormat": "{{mode}} p95",
     "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(oracle_relay_sign_latency_seconds_bucket[2m])))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 102,
   "type": "row",
   "title": "Throughput \u2014 feed \u2192 relay \u2192 main",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 32
   },
   "panels": []
  },
  {
   "id": 25,
   "type": "timeseries",
   "title": "Message funnel \u2014 feed \u2192 relay \u2192 main (msg/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 33
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(oracle_feed_submitted_total[1m]))",
     "refId": "A",
     "legendFormat": "submitted (feed \u2192 oracle)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(oracle_relay_delivered_total[1m]))",
     "refId": "B",
     "legendFormat": "delivered (relay \u2192 main)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(oracle_relay_confirmed_total[1m]))",
     "refId": "C",
     "legendFormat": "confirmed (on main)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(oracle_relay_skipped_stale_total[1m]))",
     "refId": "D",
     "legendFormat": "skipped (superseded seq)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "mps"
    },
    "overrides": []
   },
   "options": {},
   "description": "Every price update flows feed \u2192 oracle chain \u2192 relay \u2192 main. The three rates should sit on top of each other at 20 msg/s; a gap means that stage is lagging. skipped = superseded by a newer sequence before delivery (expected under backlog, not a loss)."
  },
  {
   "id": 101,
   "type": "timeseries",
   "title": "Batching \u2014 messages packed per delivery tx",
   "description": "Warp messages carried by each delivery tx on main (max 16). 1 = relaying in real time; higher = the relay is draining a backlog by batching. Rising batch size with flat delivery latency is the system absorbing load, not falling behind.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 33
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(oracle_relay_batch_size_sum[1m])) / sum(rate(oracle_relay_batch_size_count[1m]))",
     "refId": "A",
     "legendFormat": "avg"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(oracle_relay_batch_size_bucket[1m])))",
     "refId": "B",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0
    },
    "overrides": []
   },
   "options": {}
  },
