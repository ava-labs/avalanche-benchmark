# Inventory for the failover lab. Copy to .env and fill in.
# After `terraform apply`, paste from the `remote_env` terraform output:
#
#   cd terraform-aws && terraform output -raw remote_env > ../.env

SSH_USER=ubuntu

# Path to the SSH private key. Defaults to ssh-agent / ~/.ssh defaults
# if unset. The terraform stack expects the matching public key to have
# been imported into AWS in BOTH us-west-1 and us-west-2 under the
# key_name in terraform-aws/config.yaml.
SSH_KEY=/home/ubuntu/.ssh/ilya-solohin-failover-bench-2026-05-04

CONTROL_IP=
DC1_NODE_IPS=
DC2_NODE_IPS=
