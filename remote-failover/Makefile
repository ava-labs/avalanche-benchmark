.PHONY: all clean deps build avalanchego node-ids

.DEFAULT_GOAL := all

AVALANCHEGO_BRANCH = configure-genesis-acp226-excess
SUBNET_EVM_ID      = srEXiWaHuhNyGwPUi444Tu47ZEDwxTWrbQiuD7FmgSAQ6X7Dy

all: deps build
	@echo "All ready."

# ----- Go binaries we ship -----

build: bin/failover bin/staking-tools

bin/failover:
	@mkdir -p bin
	go build -o bin/failover ./cmd/failover

bin/staking-tools:
	@mkdir -p bin
	go build -o bin/staking-tools ./cmd/staking-tools

# ----- avalanchego + subnet-evm plugin (the things we scp to chain nodes) -----

deps: bin/avalanchego bin/$(SUBNET_EVM_ID)
	@echo "Dependencies ready."

bin/avalanchego bin/$(SUBNET_EVM_ID):
	@mkdir -p bin
	rm -rf /tmp/avalanchego-build-failover
	git clone --depth 1 --branch $(AVALANCHEGO_BRANCH) https://github.com/ava-labs/avalanchego.git /tmp/avalanchego-build-failover
	cd /tmp/avalanchego-build-failover && ./scripts/build.sh
	cd /tmp/avalanchego-build-failover && ./graft/subnet-evm/scripts/build.sh || true
	cp /tmp/avalanchego-build-failover/build/avalanchego bin/avalanchego
	cp /tmp/avalanchego-build-failover/build/subnet-evm bin/$(SUBNET_EVM_ID)
	rm -rf /tmp/avalanchego-build-failover

# ----- regenerate staking/node-ids.env from the committed certs -----
# Use this after generating fresh staking keys; otherwise the file is
# committed and need not be regenerated.

node-ids: bin/staking-tools
	@{ \
		echo "# Generated by 'make node-ids'. Do not edit by hand."; \
		echo ""; \
		echo "CONTROL_1_NODE_ID=$$(./bin/staking-tools node-id staking/control/1/staker.crt)"; \
		echo "CONTROL_2_NODE_ID=$$(./bin/staking-tools node-id staking/control/2/staker.crt)"; \
		echo ""; \
		echo "DC1_1_NODE_ID=$$(./bin/staking-tools node-id staking/dc1/1/staker.crt)"; \
		echo "DC1_2_NODE_ID=$$(./bin/staking-tools node-id staking/dc1/2/staker.crt)"; \
		echo "DC1_3_NODE_ID=$$(./bin/staking-tools node-id staking/dc1/3/staker.crt)"; \
		echo "DC1_4_NODE_ID=$$(./bin/staking-tools node-id staking/dc1/4/staker.crt)"; \
		echo "DC1_5_NODE_ID=$$(./bin/staking-tools node-id staking/dc1/5/staker.crt)"; \
	} > staking/node-ids.env
	@echo "Wrote staking/node-ids.env"

clean:
	rm -rf bin/
