# Local single-box benchmark config — runs the ENTIRE topology on localhost using
# the prebuilt bin/ binaries (NO avalanchego source build). Copy to .env:
#
#   cp .env.local.example .env
#
# One-time loopback ssh setup (the harness is ssh-driven; it ssh's to 127.0.0.1):
#   cat ~/.ssh/<your-key>.pub >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys
#   ssh -i ~/.ssh/<your-key> $USER@127.0.0.1 true   # must succeed key-only
#
# Then the normal pipeline runs unchanged against localhost:
#   ./01_bootstrap_primary_network.sh   # 5 local P-chain primaries (9650-lane)
#   ./02_create_l1.sh ./03_wipe_and_deploy_l1.sh
#   ./bin/reconcile endpoints           # inspect the resolved co-located layout
#   ./05_benchmark.sh
#
# This is a FUNCTIONAL / plumbing test, not a source of trustworthy latency
# numbers: all nodes share one box's CPU + one disk, so absolute p50/p95 are
# contention-inflated. Use it to validate topology/failover/the proposerVM knobs
# before spending on AWS; an A/B (e.g. proposer window) is still valid since the
# contention is a constant offset on both arms.

SSH_USER=youruser
SSH_KEY_PATH=/home/youruser/.ssh/your-loopback-key

# Single-box loopback: every node (primaries + L1) advertises 127.0.0.1 so peers
# dial loopback. Without this the harness curls the NAT IP, which the co-located
# nodes cannot reach -> L1 wedges in BOOTSTRAPPING. Leave UNSET for real fleets.
PCHAIN_PUBLIC_IP=127.0.0.1

# Deploy the L1 nodes to a dir OTHER than the repo (repo == ~/avalanche-benchmark;
# deploying there would scp the binaries onto themselves). Co-located nodes get
# per-instance subdirs + ports (9652,9662,... / 9653,9663,...) under here.
REMOTE_DIR=~/avabench-run

# Validated 3/1/2 shape, all co-located on one box (length = count, repeated IP =
# co-locate). 6 L1 nodes total. Co-location warning from reconcile is expected.
VALIDATOR_IPS=127.0.0.1,127.0.0.1,127.0.0.1
SPARE_IPS=127.0.0.1
RPC_IPS=127.0.0.1,127.0.0.1
