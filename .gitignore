# Local operator config and generated run metadata
/.env
**/.env
/nodes.ini
/network.env
/network-info.env
/registry.json
/deployment/

# Secrets that must NEVER be committed:
#   - the funded Fuji wallet key (controls real AVAX)
#   - the manager-L1 committee BLS/staking keys (handover secrets, backed up
#     out of band, not via git)
/staking/fuji-wallet.key
/staking/manager/

# Build/dependency artifacts
/bin/
/.build/
/avalanchego
/benchmark
/bombard
/l1
/srEXiWaHuhNyGwPUi444Tu47ZEDwxTWrbQiuD7FmgSAQ6X7Dy
# Cross-compiled binaries (make pack)
/*-linux
/*-linux-amd64

# Deployment packages
/avalanche-benchmark.tar.gz
/remote-benchmark.tar.gz
/pchain.tar.gz
/avalanche-benchmark-*.tar.gz
/avalanche-benchmark-*.rpm
# RPM staging tree (make rpm)
/dist/

# Runtime data and logs
/data/
/runtime-data/
*.log
*.out
nohup.out

# Terraform local state/config
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.*
**/tfplan
**/*.tfvars
!**/*.tfvars.example
**/config.yaml
!**/config.yaml.example

# Monitoring: only the scrape target list is generated (fleet targets).
# prometheus.yml, alerts.yml, dashboards, and the compose file are shipped.
/monitoring/targets.json
/monitoring/provisioning/

# Foundry (apps/*/contracts/): deps and build outputs are regenerable; the Go
# build consumes only the checked-in embedded artifacts
apps/*/contracts/lib/
apps/*/contracts/cache/
apps/*/contracts/out/

# Local editor/agent state
/.claude/
/.legacy/
.DS_Store
.linux-build/
/.questions/
/.bundle-denylist

# Local planning documents: never committed, they move to the private repo
/MULTICHAIN-PLAN.md
/PROPOSAL.md
/PACKAGE-SPEC.md
