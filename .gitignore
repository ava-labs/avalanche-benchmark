# Demo-generated working dirs
/blockscout/
/multi-node/
/single-node/

# Local-only AWS demo harness (personal paths; never commit)
/two-dc-demo.sh

# Monitoring runtime (generated by 04_monitoring.sh; bin/ binaries already ignored)
/monitoring/prometheus.yml
/monitoring/provisioning/

# Foundry (contracts/): deps and build outputs are regenerable; the Go build
