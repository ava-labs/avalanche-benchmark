# Multi-node benchmark configuration
# Copy this file to .env and fill in your values

# SSH username for connecting to nodes
SSH_USER=ubuntu

# Exactly five benchmark node IPs. P-chain validators run locally on this dev
# machine; these hosts run L1 validators only.
NODE_IPS=1.2.3.1,1.2.3.2,1.2.3.3,1.2.3.4,1.2.3.5
