# Every command explicitly loads this file from the repository root.
# Copy it to .env, then provide every required value explicitly.

# Supported values: fuji, mainnet. Always call Fuji "Fuji", never "testnet".
NETWORK=fuji

# Required P-chain API for the selected network.
PCHAIN_API=https://api.avax-test.network

# Optional rate-limit bypass token for the public API, sent as the "token"
# query argument on every request to the PCHAIN_API host and to no other host.
# Leave empty here. It is a secret: never commit a value and never ship one in
# a build. Do not append it to PCHAIN_API; the AvalancheGo client overwrites
# the query string, so a token placed there is silently dropped.
PCHAIN_API_TOKEN=

# Raw 32-byte secp256k1 private key as 64 hex characters, without a 0x prefix.
# The same key owns P-chain creation and fee transactions; its derived EVM
# address receives the main L1's genesis allocation. There is no second key,
# key-file setting, or built-in funded account. Never commit the populated .env.
FUNDING_PRIVATE_KEY=

# Fleet access from the deployment control machine.
SSH_USER=ubuntu
SSH_KEY_PATH=/path/to/fleet-key

# Install root on the machines. The user-level install is the default: all
# fleet files go under this directory, no command uses sudo, and nodes run
# as normal processes. Empty means /home/<SSH_USER>/avalanche-benchmark.
REMOTE_DIR=

# Optional: put chain databases and logs on a faster disk. Empty means the
# data/ subdirectory of the install root.
REMOTE_DATA_DIR=

# Legacy root install (/opt, /etc, /var/lib, systemd, sudo everywhere).
# It gives restart-on-crash and start-on-boot, and it needs passwordless
# sudo. It cannot be combined with REMOTE_DIR or REMOTE_DATA_DIR.
SYSTEM_INSTALL=false
