# Multi-node benchmark configuration
# Copy this file to .env and fill in your values

# SSH username for connecting to nodes
SSH_USER=ubuntu

# Node IPs (comma-separated, first node is the bootstrap + monitoring host)
# Examples:
#   Single validator:  NODE_IPS=1.2.3.1
#   Three validators:  NODE_IPS=1.2.3.1,1.2.3.2,1.2.3.3
NODE_IPS=1.2.3.1,1.2.3.2,1.2.3.3

# Production-closer mode for five-node local-genesis benchmark:
# - primary processes use staking/l1/1..5 on port 9650
# - L1 validators use staking/l1/6..10 on port 9652
SYBIL_ENABLED_LOCAL=true
L1_VALIDATOR_START_INDEX=6
L1_VALIDATOR_COUNT=5
